ex:testType a rdf:Property ;
    rdfs:label "IVD test type" .

ex:effectiveDateRaw a rdf:Property ;
    rdfs:label "effective date (raw string)" .

# Mammography / facility fields

ex:facilityName a rdf:Property ;
    rdfs:label "facility name" .

ex:phone a rdf:Property ;
    rdfs:label "phone number" .

ex:zipCode a rdf:Property ;
    rdfs:label "ZIP / postal code" .

ex:accreditationBody a rdf:Property ;
    rdfs:label "accreditation body" .

ex:certificateNumber a rdf:Property ;
    rdfs:label "MQSA certificate number" .

# Recognized standards fields

ex:recognitionNumber a rdf:Property ;
    rdfs:label "FDA recognition number" .

ex:organization a rdf:Property ;
    rdfs:label "standards organization" .

ex:standardDesignation a rdf:Property ;
    rdfs:label "standard designation number" .

ex:ascaPilot a rdf:Property ;
    rdfs:label "ASCA pilot program flag" .

# 522 Postmarket Study fields

