# rdf/ontology.ttl

@prefix ex: <http://medicaldevice.com/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# =========================
# ABSTRACT / SHARED CLASSES
# =========================

ex:MedicalDevice a rdfs:Class ;
    rdfs:label "Medical Device" .

ex:FDADataRecord a rdfs:Class ;
    rdfs:label "FDA Data Record" .

ex:RegulatorySubmission a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "Regulatory Submission" .

ex:AdverseEventReport a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "Adverse Event Report" .

ex:SafetyReport a rdfs:Class ;
    rdfs:subClassOf ex:AdverseEventReport ;
    rdfs:label "Safety Report" .

ex:Manufacturer a rdfs:Class ;
    rdfs:label "Manufacturer / Organization" .

ex:ProductCode a rdfs:Class ;
    rdfs:label "FDA Product Code" .

ex:RegulationNumber a rdfs:Class ;
    rdfs:label "Regulation Number" .

ex:ApprovalPathway a rdfs:Class ;
    rdfs:label "Approval Pathway" .

ex:DeviceIdentifier a rdfs:Class ;
    rdfs:label "Device Identifier (UDI)" .

ex:GMDNTerm a rdfs:Class ;
    rdfs:label "GMDN Term" .

ex:DeviceProblem a rdfs:Class ;
    rdfs:label "Device Problem" .

ex:PatientOutcome a rdfs:Class ;
    rdfs:label "Patient Outcome" .

ex:SafetySignal a rdfs:Class ;
    rdfs:label "Safety Signal" .

ex:Recall a rdfs:Class ;
    rdfs:label "Recall" .

ex:DesignChange a rdfs:Class ;
    rdfs:label "Design Change" .

ex:DeviceMaterial a rdfs:Class ;
    rdfs:label "Device Material" .

ex:DeviceComponent a rdfs:Class ;
    rdfs:label "Device Component" .

ex:Material a rdfs:Class ;
    rdfs:subClassOf ex:DeviceMaterial ;
    rdfs:label "Material" .

ex:Component a rdfs:Class ;
    rdfs:subClassOf ex:DeviceComponent ;
    rdfs:label "Component" .

ex:SoftwareFeature a rdfs:Class ;
    rdfs:label "Software Feature" .

ex:MDRStatistic a rdfs:Class ;
    rdfs:label "MDR Statistic" .

# =========================
# DATASET-SPECIFIC CLASSES
# =========================

ex:MAUDEReport a rdfs:Class ;
    rdfs:subClassOf ex:AdverseEventReport ;
    rdfs:label "MAUDE Adverse Event Report" .

ex:MedSunReport a rdfs:Class ;
    rdfs:subClassOf ex:AdverseEventReport ;
    rdfs:label "MedSun Safety Report" .

ex:TPLCRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "TPLC Device Record" .

ex:K510Record a rdfs:Class ;
    rdfs:subClassOf ex:RegulatorySubmission ;
    rdfs:label "510(k) Submission" .

ex:PMARecord a rdfs:Class ;
    rdfs:subClassOf ex:RegulatorySubmission ;
    rdfs:label "PMA Submission" .

ex:PMAChangeMemo a rdfs:Class ;
    rdfs:subClassOf ex:DesignChange ;
    rdfs:label "PMA Design Change / Supplement" .

ex:AccessGUDIDRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "AccessGUDID / UDI Record" .

ex:DeNovoRecord a rdfs:Class ;
    rdfs:subClassOf ex:RegulatorySubmission ;
    rdfs:label "De Novo Authorization" .

ex:RecallRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "Device Recall Record" .

ex:ProductClassificationRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA Product Classification Code" .

ex:RegistrationListingRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA Registration and Listing Record" .

ex:DeviceListing a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA Device Listing" .

# =========================
# CROSS-DATASET OBJECT PROPERTIES
# =========================

ex:involvesDevice a rdf:Property ;
    rdfs:range ex:MedicalDevice ;
    rdfs:label "involves device" .

ex:linkedMedicalDevice a rdf:Property ;
    rdfs:range ex:MedicalDevice ;
    rdfs:label "linked medical device" .

ex:hasProductCode a rdf:Property ;
    rdfs:range ex:ProductCode ;
    rdfs:label "has product code" .

ex:linkedProductCode a rdf:Property ;
    rdfs:range ex:ProductCode ;
    rdfs:label "linked product code" .

ex:relatedProductCode a rdf:Property ;
    rdfs:range ex:ProductCode ;
    rdfs:label "related product code" .

ex:sameProductCodeAs a rdf:Property ;
    rdfs:label "same product code as" .

ex:possiblySameDeviceAs a rdf:Property ;
    rdfs:label "possibly same device as" .

ex:madeBy a rdf:Property ;
    rdfs:range ex:Manufacturer ;
    rdfs:label "made by" .

ex:reportedBy a rdf:Property ;
    rdfs:range ex:Manufacturer ;
    rdfs:label "reported by" .

ex:hasManufacturer a rdf:Property ;
    rdfs:range ex:Manufacturer ;
    rdfs:label "has manufacturer" .

# Record-level links

ex:hasFDARecord a rdf:Property ;
    rdfs:range ex:FDADataRecord ;
    rdfs:label "has FDA record" .

ex:hasMAUDEReport a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:MAUDEReport ;
    rdfs:label "has MAUDE report" .

ex:hasMedSunReport a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:MedSunReport ;
    rdfs:label "has MedSun report" .

ex:hasTPLCRecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:TPLCRecord ;
    rdfs:label "has TPLC record" .

ex:has510kRecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:K510Record ;
    rdfs:label "has 510(k) record" .

ex:hasPMARecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:PMARecord ;
    rdfs:label "has PMA record" .

ex:hasPMADesignChange a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:PMAChangeMemo ;
    rdfs:label "has PMA design change" .

ex:hasDesignChange a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:PMAChangeMemo ;
    rdfs:label "has design change" .

ex:hasAccessGUDIDRecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:AccessGUDIDRecord ;
    rdfs:label "has AccessGUDID record" .

# Safety / problem / outcome links

ex:hasProblem a rdf:Property ;
    rdfs:range ex:DeviceProblem ;
    rdfs:label "has problem" .

ex:hasDeviceProblem a rdf:Property ;
    rdfs:range ex:DeviceProblem ;
    rdfs:label "has device problem" .

ex:hasOutcome a rdf:Property ;
    rdfs:range ex:PatientOutcome ;
    rdfs:label "has outcome" .

ex:hasPatientOutcome a rdf:Property ;
    rdfs:range ex:PatientOutcome ;
    rdfs:label "has patient outcome" .

ex:hasSafetySignal a rdf:Property ;
    rdfs:range ex:SafetySignal ;
    rdfs:label "has safety signal" .

ex:hasRecall a rdf:Property ;
    rdfs:domain ex:TPLCRecord ;
    rdfs:range ex:Recall ;
    rdfs:label "has recall" .

# Device characteristic links

ex:hasMaterial a rdf:Property ;
    rdfs:range ex:Material ;
    rdfs:label "has material" .

ex:hasComponent a rdf:Property ;
    rdfs:range ex:Component ;
    rdfs:label "has component" .

ex:hasSoftware a rdf:Property ;
    rdfs:range ex:SoftwareFeature ;
    rdfs:label "has software" .

ex:hasDeviceIdentifier a rdf:Property ;
    rdfs:range ex:DeviceIdentifier ;
    rdfs:label "has device identifier" .

ex:hasGMDNTerm a rdf:Property ;
    rdfs:range ex:GMDNTerm ;
    rdfs:label "has GMDN term" .

ex:hasMDRStatistic a rdf:Property ;
    rdfs:domain ex:TPLCRecord ;
    rdfs:range ex:MDRStatistic ;
    rdfs:label "has MDR statistic" .

ex:hasDeNovoRecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:DeNovoRecord ;
    rdfs:label "has De Novo record" .

ex:hasRecallRecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:RecallRecord ;
    rdfs:label "has recall record" .

ex:hasClassificationRecord a rdf:Property ;
    rdfs:domain ex:ProductCode ;
    rdfs:range ex:ProductClassificationRecord ;
    rdfs:label "has classification record" .

ex:hasRegistrationRecord a rdf:Property ;
    rdfs:domain ex:Manufacturer ;
    rdfs:range ex:RegistrationListingRecord ;
    rdfs:label "has registration record" .

ex:hasDeviceListing a rdf:Property ;
    rdfs:domain ex:RegistrationListingRecord ;
    rdfs:range ex:DeviceListing ;
    rdfs:label "has device listing" .

ex:registeredAt a rdf:Property ;
    rdfs:domain ex:DeviceListing ;
    rdfs:range ex:RegistrationListingRecord ;
    rdfs:label "registered at establishment" .

ex:hasYearlyTrend a rdf:Property ;
    rdfs:domain ex:TPLCRecord ;
    rdfs:range ex:MDRStatistic ;
    rdfs:label "has yearly trend" .

ex:hasRegulationNumber a rdf:Property ;
    rdfs:range ex:RegulationNumber ;
    rdfs:label "has regulation number" .

ex:hasApprovalPathway a rdf:Property ;
    rdfs:range ex:ApprovalPathway ;
    rdfs:label "has approval pathway" .

ex:hasPredicateDevice a rdf:Property ;
    rdfs:label "has predicate device" .

ex:supplementsPMA a rdf:Property ;
    rdfs:label "supplements PMA" .

# Design change affect properties

ex:affectsMaterial a rdf:Property ;
    rdfs:label "affects material" .

ex:affectsSoftware a rdf:Property ;
    rdfs:label "affects software" .

ex:affectsComponent a rdf:Property ;
    rdfs:label "affects component" .

ex:affectsLabeling a rdf:Property ;
    rdfs:label "affects labeling" .

ex:affectsPackaging a rdf:Property ;
    rdfs:label "affects packaging" .

ex:affectsSterility a rdf:Property ;
    rdfs:label "affects sterility" .

