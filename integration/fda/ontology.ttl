# =========================
# PROVENANCE / AUDIT CLASSES  (kg-json-v4)
# =========================

ex:SourceRecord a rdfs:Class ;
    rdfs:label "Source Record (raw FDA record)" .

ex:ProvenanceRecord a rdfs:Class ;
    rdfs:label "Provenance / Extraction Audit Record" .

ex:Dataset a rdfs:Class ;
    rdfs:label "FDA Source Dataset" .

# =========================
# NEW DATASET-SPECIFIC CLASSES
# =========================

ex:CLIARecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "CLIA Laboratory Test System Record" .

ex:CLIAWaivedRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "CLIA Waived Analyte Record" .

ex:IVDRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "IVD Home Use (OTC) Test Record" .

ex:MammographyFacility a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "MQSA Certified Mammography Facility" .

ex:RecognizedStandard a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA Recognized Consensus Standard" .

ex:Postmarket522Study a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA 522 Postmarket Surveillance Study" .

ex:HDERecord a rdfs:Class ;
    rdfs:subClassOf ex:RegulatorySubmission ;
    rdfs:label "Humanitarian Device Exemption (HDE)" .

ex:XRayAssemblerRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "FDA X-Ray Assembler Record" .

ex:DevicesFDARecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "Devices@FDA Catalog Record" .

# =========================
# CLIA-SPECIFIC CLASSES
# =========================

ex:TestSystem a rdfs:Class ;
    rdfs:label "CLIA Test System" .

ex:Analyte a rdfs:Class ;
    rdfs:label "Analyte (measurand)" .

ex:Specialty a rdfs:Class ;
    rdfs:label "CLIA Laboratory Specialty" .

# =========================
# NEW OBJECT PROPERTIES
# =========================

ex:hasTestSystem a rdf:Property ;
    rdfs:domain ex:CLIARecord ;
    rdfs:range ex:TestSystem ;
    rdfs:label "has test system" .

ex:hasAnalyte a rdf:Property ;
    rdfs:range ex:Analyte ;
    rdfs:label "has analyte" .

ex:hasSpecialty a rdf:Property ;
    rdfs:domain ex:CLIARecord ;
    rdfs:range ex:Specialty ;
    rdfs:label "has specialty" .

ex:hasCLIARecord a rdf:Property ;
    rdfs:range ex:CLIARecord ;
    rdfs:label "has CLIA record" .

ex:hasMammographyFacility a rdf:Property ;
    rdfs:range ex:MammographyFacility ;
    rdfs:label "has mammography facility" .

ex:hasRecognizedStandard a rdf:Property ;
    rdfs:range ex:RecognizedStandard ;
    rdfs:label "has recognized standard" .

ex:hasPostmarket522Study a rdf:Property ;
    rdfs:range ex:Postmarket522Study ;
    rdfs:label "has 522 postmarket study" .

ex:hasHDERecord a rdf:Property ;
    rdfs:domain ex:MedicalDevice ;
    rdfs:range ex:HDERecord ;
    rdfs:label "has HDE record" .

ex:hasProvenance a rdf:Property ;
    rdfs:range ex:ProvenanceRecord ;
    rdfs:label "has provenance record" .

ex:fromDataset a rdf:Property ;
    rdfs:range ex:Dataset ;
    rdfs:label "sourced from dataset" .

# =========================
# NEW DATATYPE PROPERTIES
# =========================

# Provenance / envelope fields

ex:sourceRecordId a rdf:Property ;
    rdfs:label "source record ID (original FDA identifier)" .

ex:retrievedAt a rdf:Property ;
    rdfs:label "timestamp when record was retrieved" .

ex:extractionVersion a rdf:Property ;
    rdfs:label "kg-json extraction version tag" .

ex:extractedAt a rdf:Property ;
    rdfs:label "timestamp when record was extracted" .

ex:rawRecord a rdf:Property ;
    rdfs:label "JSON literal of the complete raw FDA record" .

# CLIA fields

ex:testSystemId a rdf:Property ;
