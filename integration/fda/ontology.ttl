ex:qualifier1 a rdf:Property ;
    rdfs:label "CLIA Qualifier 1" .

ex:qualifier2 a rdf:Property ;
    rdfs:label "CLIA Qualifier 2" .

ex:complexity a rdf:Property ;
    rdfs:label "CLIA complexity level" .

ex:dateEffective a rdf:Property ;
    rdfs:label "date effective" .

# IVD / home-use fields

ex:testName a rdf:Property ;
