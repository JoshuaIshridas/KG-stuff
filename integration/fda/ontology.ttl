# =============================================================================
# UDI IDENTIFIER — AccessGUDID identifiers[] decomposition
# =============================================================================

ex:UDIIdentifier a rdfs:Class ;
    rdfs:label "UDI Device Identifier or Package Identifier" ;
    rdfs:comment "One entry from the AccessGUDID identifiers[] array. May be a Primary DI, Package DI, or Unit-of-Use DI." .

ex:hasIdentifier a rdf:Property ;
    rdfs:domain ex:AccessGUDIDRecord ;
    rdfs:range  ex:UDIIdentifier ;
    rdfs:label "links an AccessGUDID device record to one of its UDI identifiers" .

ex:belongsToDevice a rdf:Property ;
    rdfs:domain ex:UDIIdentifier ;
    rdfs:range  ex:AccessGUDIDRecord ;
    rdfs:label "back-link from a UDI identifier node to its parent device record" .

ex:identifierId a rdf:Property ;
    rdfs:label "UDI identifier value — the DI, Package DI, or PI string (e.g. GTIN-14)" .

ex:identifierType a rdf:Property ;
    rdfs:label "UDI identifier type: Primary DI / Package DI / Unit of Use DI" .

ex:issuingAgency a rdf:Property ;
    rdfs:label "UDI issuing agency: GS1 / HIBCC / ICCBBA / NDC" .

ex:packageType a rdf:Property ;
    rdfs:label "package type description associated with this identifier (e.g. Box, Case)" .

ex:quantityPerUnitOfUse a rdf:Property ;
    rdfs:label "quantity of base devices contained in this package unit" .

ex:unitOfUseId a rdf:Property ;
    rdfs:label "Unit-of-Use identifier string (UoU DI)" .

ex:identifierStatus a rdf:Property ;
    rdfs:label "device identifier status: Active / Inactive / Deprecated" .

# =========================
# CROSS-GRAPH IDENTIFIERS (NAICS / geospatial)
#
# Added to support joining this KG with other Proto-OKN graphs:
#   - SUDOKN, via shared NAICS industry codes
#   - SpatialKG, via facility WGS84 coordinates
#
# The FDA Product Code -> NAICS mapping is an INFERRED crosswalk (our own
# rule-based/LLM-assisted classification of what industry manufactures a
# given FDA-defined device type), not data supplied by FDA. Provenance is
# preserved on ex:ProductCodeNAICSMapping so this distinction stays
# queryable. See FDA_Parse_TPLC_Pipeline/crossgraph/ and README.md
# "Cross-Graph Integration".
# =========================

ex:NAICSClassification a rdfs:Class ;
    rdfs:label "NAICS Industry Classification (US Census)" .

ex:ProductCodeNAICSMapping a rdfs:Class ;
    rdfs:label "FDA Product Code to NAICS Crosswalk Assertion (inferred, with provenance)" .

ex:Facility a rdfs:Class ;
    rdfs:subClassOf ex:RegistrationListingRecord ;
    rdfs:label "FDA-registered establishment/facility with a geocodable address" .

ex:hasNAICSClassification a rdf:Property ;
    rdfs:range ex:NAICSClassification ;
    rdfs:label "has NAICS classification (domain: ex:ProductCode or ex:Manufacturer)" .

ex:hasNAICSMapping a rdf:Property ;
    rdfs:domain ex:ProductCode ;
    rdfs:range ex:ProductCodeNAICSMapping ;
    rdfs:label "has NAICS crosswalk mapping (provenance-bearing)" .

ex:assignedNAICS a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:range ex:NAICSClassification ;
    rdfs:label "NAICS code assigned by this crosswalk mapping" .

ex:naicsCode a rdf:Property ;
    rdfs:domain ex:NAICSClassification ;
    rdfs:label "six-digit NAICS code literal (cross-graph join key)" .

ex:naicsVersion a rdf:Property ;
    rdfs:domain ex:NAICSClassification ;
    rdfs:label "NAICS taxonomy version, e.g. 2022" .

ex:mappingMethod a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:label "how this NAICS mapping was derived: definition_match / llm_assisted / manual_review / unmapped" .

ex:mappingConfidence a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:label "0.0-1.0 confidence score for this NAICS mapping" .

ex:mappingReviewStatus a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:label "approved / manual_review" .

ex:mappingReason a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:label "human-readable evidence/justification for this NAICS mapping" .

ex:mappingSource a rdf:Property ;
    rdfs:domain ex:ProductCodeNAICSMapping ;
    rdfs:label "provenance label, e.g. internal_crosswalk (never claims FDA supplied the NAICS code)" .

ex:geocodingSource a rdf:Property ;
    rdfs:domain ex:Facility ;
    rdfs:label "geocoding provider used, e.g. census / nominatim" .

ex:geocodingConfidence a rdf:Property ;
    rdfs:domain ex:Facility ;
    rdfs:label "0.0-1.0 confidence score returned by the geocoder" .

ex:normalizedAddress a rdf:Property ;
    rdfs:domain ex:Facility ;
    rdfs:label "normalized single-line address used as the geocoding cache key" .

# Latitude/longitude use the standard WGS84 Geo Positioning vocabulary
# (http://www.w3.org/2003/01/geo/wgs84_pos#) rather than a custom predicate,
# per project convention of reusing standard vocabularies when introducing
# geospatial data. See rdf/turtle_writer.py PREFIXES / crossgraph/rdf_geo.py.
#
# External interoperability vocabularies (used but NOT redefined here — we
# don't own these terms, we only reuse them; see crossgraph/rdf_naics.py and
# crossgraph/rdf_geo.py for exactly where/how):
#   sudokn:    <http://asu.edu/semantics/SUDOKN/>              — NAICSClassifier, hasNAICSClassifier
#   iof:       <https://spec.industrialontologies.org/ontology/core/Core/>  — Manufacturer
#   geosparql: <http://www.opengis.net/ont/geosparql#>          — Feature, Geometry, hasGeometry,
#                                                                  defaultGeometry, asWKT, wktLiteral
# ex:Manufacturer and ex:NAICSClassification/ex:Facility instances are
# dual-typed with these external classes, and ex:hasNAICSClassification is
# paired with sudokn:hasNAICSClassifier, so a SUDOKN- or GeoSPARQL-aware
# consumer can use our data without needing our ex: vocabulary at all — see
# README.md "Cross-Graph Integration" for the full rationale.
